{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/v17.11.2/schemas/config.json",
  "release-type": "simple",
  "include-component-in-tag": false,
  "bump-minor-pre-major": true,
  "signoff": "github-actions[bot] <41898282+github-actions[bot]@users.noreply.github.com>",
  "skip-changelog": true,
  "changelog-sections": [
    { "type": "feat", "section": "Features" },
    { "type": "fix", "section": "Fixes" },
    { "type": "perf", "section": "Performance" },
    { "type": "revert", "section": "Reverts" }
  ],
  "packages": {
    ".": {
      "package-name": "pg_rebac",
      "extra-files": [
        { "type": "toml", "path": "Cargo.toml", "jsonpath": "$.workspace.package.version" },
        { "type": "toml", "path": "crates/rebacd/Cargo.toml", "jsonpath": "$.dependencies['rebac-schema'].version" },
        {
          "type": "toml",
          "path": "Cargo.lock",
          "jsonpath": "$.package[?(@.name.value==='rebac-schema' || @.name.value==='rebacd')].version"
        },
        { "type": "json", "path": "META.json", "jsonpath": "$.version" },
        { "type": "json", "path": "META.json", "jsonpath": "$.provides.pg_rebac.version" },
        { "type": "json", "path": "packages/npm/package.json", "jsonpath": "$.version" }
      ]
    }
  }
}
