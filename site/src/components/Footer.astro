---
// Starlight's own footer (edit link, pagination), then the maker's line and the repository on every docs page.
import Default from "@astrojs/starlight/components/Footer.astro";
import GitHubMark from "./GitHubMark.astro";
import MadeBy from "./MadeBy.astro";
---
<Default><slot /></Default>
<div class="docs-made-by">
  <MadeBy />
  <a class="docs-gh" href="https://github.com/louvain-ai/pg_rebac"><GitHubMark size={16} /><span>louvain-ai/pg_rebac</span></a>
</div>
<style>
  .docs-made-by {
    display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1rem;
    margin-top: 2.5rem; padding-top: 1.25rem; border-top: 1px solid var(--sl-color-hairline); color: var(--sl-color-gray-3);
  }
  .docs-gh { display: inline-flex; align-items: center; gap: 0.5em; font-size: 0.875rem; color: inherit; text-decoration: none; }
  .docs-gh:hover span { text-decoration: underline; text-underline-offset: 0.18em; }
</style>
